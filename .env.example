# Copy to .env and fill in values. Do not commit .env.
# Precedence: environment / this file > settings.toml > built-in defaults.
# After changing values, restart the container (`docker compose up -d`).

# --- API (required for vision_query / VLM captcha_ocr) ---
# OpenRouter:
#   BASE_URL=https://openrouter.ai/api/v1
# LLM on the Docker host:
#   BASE_URL=http://host.docker.internal:1234/v1
BASE_URL=
API_KEY=

# Optional: mount a different settings file instead of /app/settings.toml
# WEBGENT_SETTINGS_PATH=/app/settings.toml

# --- [agent] model names (override settings.toml without rebuilding the image) ---
# WEBGENT_LLM_MODEL=openrouter/free
# WEBGENT_VLM_MODEL=openrouter/free
# WEBGENT_EMB_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# --- [browser] ---
# WEBGENT_HEADLESS=true
# WEBGENT_DISPLAY=:0.0
# WEBGENT_CHROMIUM_ARGS=
# WEBGENT_IN_DOCKER=1

# --- [server] ---
# WEBGENT_SERVER_TRANSPORT=http
# WEBGENT_SERVER_HOST=0.0.0.0
# WEBGENT_SERVER_PORT=3333

# --- [proxy] ---
# WEBGENT_PROXY_ENABLED=true
# WEBGENT_PROXY_MODE=embedded
# WEBGENT_PROXY_HOST=127.0.0.1
# WEBGENT_PROXY_PORT=8888
# WEBGENT_PROXY_EXTERNAL_SERVER=
# WEBGENT_PROXY_MAX_BODY_BYTES=1048576
# WEBGENT_PROXY_BYPASS_LOOPBACK=false

# --- [snapshot] ---
# WEBGENT_SNAPSHOT_LIST_THRESHOLD=30
# WEBGENT_SNAPSHOT_LIST_HEAD=10
# WEBGENT_SNAPSHOT_LIST_TAIL=10
# WEBGENT_SNAPSHOT_IFRAME_RETRY_COUNT=2
# WEBGENT_SNAPSHOT_IFRAME_RETRY_DELAY_S=0.5

# --- [mcp.cursor] ---
# WEBGENT_MCP_URL=http://127.0.0.1:3333/mcp
# WEBGENT_MCP_PROMPT=agent_system_prompt
# WEBGENT_MCP_SERVER_INFO_RESOURCE=webgent://server-info
